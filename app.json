{
  "expo": {
    "name": "foodflic",
    "slug": "foodflic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
       [
        "expo-media-library",
        {
          "photosPermission": "Allow Foodflic to access your photos.",
          "savePhotosPermission": "Allow Foodflic to save photos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo"]
        }
       ],
       [
        "expo-image-picker",
        {
          "photosPermission": "Allow Foodflic to access your photos.",
          "cameraPermisson": "Allow Foodflic to access your camera",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
       ],
       [
         "expo-camera",
        {
          "cameraPermission": "Allow Foodflic to access your camera"
        }
       ]
    ]
  }
}
